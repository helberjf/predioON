diff --git a/.github/workflows/android-password.yml b/.github/workflows/android-password.yml
new file mode 100644
index 0000000..9706ed5
--- /dev/null
+++ b/.github/workflows/android-password.yml
@@ -0,0 +1,149 @@
+name: Android own password change
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'apps/*-mobile/**'
+      - 'apps/api/src/auth/**'
+      - 'packages/mobile/**'
+      - 'packages/api-client/**'
+      - 'packages/contracts/src/auth.ts'
+      - 'packages/db/src/**'
+      - 'infrastructure/*.sql'
+      - 'pnpm-lock.yaml'
+      - 'scripts/android-smoke/**'
+      - 'scripts/android-auth-smoke/**'
+      - 'scripts/android-password-smoke/**'
+      - '.github/workflows/android-password.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: android-password-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  authenticated:
+    runs-on: ubuntu-latest
+    timeout-minutes: 80
+    services:
+      postgres:
+        image: timescale/timescaledb:2.17.2-pg16
+        env:
+          POSTGRES_USER: predioon
+          POSTGRES_PASSWORD: predioon
+          POSTGRES_DB: predioon
+          TIMESCALEDB_TELEMETRY: 'off'
+        ports: ['5436:5432']
+        options: >-
+          --health-cmd "pg_isready -U predioon -d predioon"
+          --health-interval 5s --health-timeout 5s --health-retries 20
+    env:
+      NODE_ENV: test
+      API_PORT: '3000'
+      JWT_ACCESS_TTL_MINUTES: '30'
+      DATABASE_URL: postgres://predioon:predioon@localhost:5436/predioon
+      DATABASE_URL_APP: postgres://predioon_app:predioon_app@localhost:5436/predioon
+      DATABASE_URL_IDENTITY: postgres://predioon_identity:predioon_identity@localhost:5436/predioon
+      DATABASE_URL_BROKER_AUTH: postgres://predioon_broker_auth:predioon_broker_auth@localhost:5436/predioon
+      ANDROID_AUTH_DISPOSABLE_DB: '1'
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '24'
+          cache: pnpm
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - uses: android-actions/setup-android@v3
+        with:
+          packages: 'platform-tools'
+          log-accepted-android-sdk-licenses: false
+      - run: pnpm install --frozen-lockfile
+      - name: Test assertions and real certificate verification
+        run: |
+          openssl version
+          python3 -m unittest discover -s scripts/android-smoke -p 'test_*.py' -v
+          python3 -m unittest discover -s scripts/android-auth-smoke -p 'test_*.py' -v
+          python3 -m unittest discover -s scripts/android-password-smoke -p 'test_*.py' -v
+      - name: Bootstrap isolated database and ephemeral credentials
+        run: |
+          pnpm db:bootstrap
+          pnpm db:infra
+          pnpm db:infra
+          pnpm db:provision-runtime
+          mkdir -p .local/android-password
+          python3 - <<'PY'
+          import os, secrets
+          password = secrets.token_hex(18)
+          new_password = ' New ' + secrets.token_hex(18) + ' phrase '
+          print(f"::add-mask::{password}")
+          print(f"::add-mask::{new_password}")
+          with open(os.environ['GITHUB_ENV'], 'a') as env:
+              env.write(f"ANDROID_AUTH_PASSWORD={password}\n")
+              env.write(f"ANDROID_PASSWORD_NEW={new_password}\n")
+          PY
+      - name: Create isolated accounts and configure verification-only APK trust
+        run: |
+          pnpm --filter @predioon/api exec tsx ../../scripts/android-auth-smoke/fixture.mts create ../../.local/android-password/fixture.json
+          python3 scripts/android-auth-smoke/tls.py --output .local/android-password/tls
+      - name: Compile and sign both verification APKs
+        run: |
+          for app in resident-mobile operations-mobile; do
+            (cd "apps/$app/android" && bash gradlew --no-daemon --refresh-dependencies :app:assembleRelease -PreactNativeArchitectures=x86_64)
+            python3 scripts/android-smoke/prepare.py sign --scenario auth --app "$app" --apk "apps/$app/android/app/build/outputs/apk/release/app-release-unsigned.apk" --output ".local/android-password/$app/verification.apk"
+          done
+      - name: Start real API and isolated HTTPS proxy
+        run: |
+          pnpm --filter @predioon/api exec tsx src/server.ts > .local/android-password/api.log 2>&1 &
+          echo $! > .local/android-password/api.pid
+          python3 scripts/android-password-smoke/password_proxy.py --tls .local/android-password/tls > .local/android-password/proxy.log 2>&1 &
+          echo $! > .local/android-password/proxy.pid
+          curl --fail --retry 30 --retry-connrefused --retry-delay 1 --max-time 3 http://127.0.0.1:3000/health/ready
+          curl --fail --cacert .local/android-password/tls/ca.pem https://127.0.0.1:3443/health
+      - name: Enable emulator hardware acceleration
+        run: |
+          nproc
+          free -m
+          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
+          sudo udevadm control --reload-rules
+          sudo udevadm trigger --name-match=kvm
+      - name: Change passwords in both coinstalled apps and prove revocation
+        uses: reactivecircus/android-emulator-runner@v2
+        with:
+          api-level: 35
+          target: google_apis
+          arch: x86_64
+          profile: pixel_6
+          cores: 4
+          ram-size: 4096M
+          force-avd-creation: true
+          disable-animations: true
+          emulator-boot-timeout: 600
+          emulator-options: -no-window -gpu swiftshader_indirect -no-snapshot -noaudio -no-boot-anim -camera-back none -camera-front none
+          script: python3 scripts/android-password-smoke/run_password.py --fixture .local/android-password/fixture.json --apks .local/android-password --artifacts .local/android-password/evidence
+      - name: Sanitize service diagnostics and remove only the fixture data
+        if: always()
+        run: |
+          python3 scripts/android-password-smoke/diagnostics.py --directory .local/android-password
+          if test -f .local/android-password/fixture.json; then
+            pnpm --filter @predioon/api exec tsx ../../scripts/android-auth-smoke/fixture.mts cleanup ../../.local/android-password/fixture.json
+          fi
+      - name: Preserve evidence without APKs, keys, passwords or tokens
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: android-password-change-${{ github.run_id }}
+          path: |
+            .local/android-password/resident-mobile/build.json
+            .local/android-password/operations-mobile/build.json
+            .local/android-password/evidence/
+          include-hidden-files: true
+          if-no-files-found: warn
+          retention-days: 7
diff --git a/apps/api/src/auth/password-change-schema.ts b/apps/api/src/auth/password-change-schema.ts
