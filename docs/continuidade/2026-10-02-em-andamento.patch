+        await owner.unsafe(migration);
+        assert.deepEqual(await owner`select to_jsonb(p) row from permissions p order by key`, before);
+        assert.deepEqual(await owner`select to_jsonb(rp) row from role_permissions rp order by role_key,permission_key`, grants);
+        assert.deepEqual(await unrelated(), functions);
+        assert.deepEqual(await owner`select * from pg_policies where schemaname='public' and tablename<>'organizations' order by tablename,policyname`, policies);
+      }
+      await owner`delete from permissions where key in ('organizations:read','organizations:manage')`;
+      await owner.unsafe(migration);
+      assert.equal((await owner`select key from permissions where key in ('organizations:read','organizations:manage')`).length, 0);
+      throw rollback;
+    }), error => error === rollback);
+    const [legacy] = await sqlClient`select has_function_privilege('predioon_app','app_can_access_organization(text)','execute') allowed`;
+    assert.equal(legacy!.allowed, false);
+    const [roles] = await sqlClient`select has_table_privilege('predioon_identity','organizations','select') identity,
+      has_table_privilege('predioon_broker_auth','organizations','select') broker,
+      has_table_privilege('predioon_notifications','organizations','select') notifications`;
+    assert.deepEqual(roles, { identity: true, broker: false, notifications: false });
+  });
+});
diff --git a/apps/api/test/authorization-platform.test.ts b/apps/api/test/authorization-platform.test.ts
new file mode 100644
index 0000000..39144a7
--- /dev/null
+++ b/apps/api/test/authorization-platform.test.ts
@@ -0,0 +1,64 @@
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { after, before, describe, it } from "node:test";
+import { sqlClient } from "@predioon/db";
+import { closeAppDb } from "@predioon/db/runtime";
+import { hashPassword } from "../src/auth/passwords.js";
+import { call, login, startTestServer, type TestServer } from "./helpers.js";
+
+describe("platform authorization exposes only the current commercial capabilities", () => {
+  let server: TestServer, passwordHash: string;
+  before(async () => { passwordHash = await hashPassword("predioon123"); server = await startTestServer(); });
+  after(async () => { await server?.close(); await closeAppDb(); await sqlClient.end(); });
+  async function fixture(run: (f: { user: string; binding: string; token: string; request: () => Promise<Response> }) => Promise<void>) {
+    const user = `org-projection-${randomUUID()}`, binding = randomUUID();
+    try {
+      await sqlClient`insert into users(id,name,email,password_hash) values(${user},'Projection fixture',${user + '@org039.test'},${passwordHash})`;
+      await sqlClient`insert into role_bindings(id,user_id,role_key) values(${binding},${user},'PLATFORM_ADMIN')`;
+      const { accessToken: token } = await login(server.url, user + '@org039.test');
+      await run({ user, binding, token, request: () => call(server.url, '/v1/authorization/platform', { token }) });
+    } finally { await sqlClient`delete from users where id=${user}`; }
+  }
+  it("returns a finite no-store projection without inventory or role-derived private powers", async () => fixture(async f => {
+    const response = await f.request();
+    assert.equal(response.status, 200, await response.clone().text());
+    assert.equal(response.headers.get('cache-control'), 'no-store');
+    assert.deepEqual(await response.json(), { capabilities: ['organizations:manage', 'organizations:read'] });
+    assert.equal((await call(server.url, '/v1/authorization')).status, 401);
+  }));
+  it("returns an empty current scope on revocation using the same session", async () => fixture(async f => {
+    assert.equal((await f.request()).status, 200);
+    for (const mutation of [
+      () => sqlClient`update role_bindings set active=false where id=${f.binding}`,
+      () => sqlClient`update role_bindings set starts_at=clock_timestamp()+interval '1 hour' where id=${f.binding}`,
+      () => sqlClient`update role_bindings set ends_at=clock_timestamp()-interval '1 second' where id=${f.binding}`,
+    ]) {
+      await mutation();
+      const response = await f.request();
+      assert.equal(response.status, 200); assert.equal(response.headers.get('cache-control'), 'no-store');
+      assert.deepEqual(await response.json(), { capabilities: [] });
+      await sqlClient`update role_bindings set active=true,starts_at=null,ends_at=null where id=${f.binding}`;
+    }
+  }));
+  it("reports read and manage independently and preserves active catalog metadata", async () => fixture(async f => {
+    for (const key of ['organizations:read', 'organizations:manage']) {
+      const [prior] = await sqlClient`select to_jsonb(p) row from permissions p where key=${key}`;
+      assert.ok(prior, '039 permission must exist for this post-migration negative');
+      try {
+        await sqlClient`update permissions set active=false where key=${key}`;
+        const response = await f.request(); assert.equal(response.status, 200);
+        assert.deepEqual(await response.json(), { capabilities: [key.endsWith(':read') ? 'organizations:manage' : 'organizations:read'] });
+      } finally {
+        await sqlClient`update permissions set (active,created_at)=(select active,created_at from jsonb_populate_record(null::permissions,${JSON.stringify(prior.row)}::jsonb)) where key=${key}`;
+      }
+    }
+  }));
+  it("requires active authenticated identity and does not turn query parameters into global authority", async () => fixture(async f => {
+    assert.equal((await call(server.url, '/v1/authorization/platform')).status, 401);
+    await sqlClient`delete from role_bindings where id=${f.binding}`;
+    const response = await call(server.url, '/v1/authorization/platform?buildingId=foreign&resourceType=organization&resourceId=any', { token: f.token });
+    assert.equal(response.status, 200); assert.deepEqual(await response.json(), { capabilities: [] });
+    await sqlClient`update users set active=false where id=${f.user}`;
+    assert.equal((await f.request()).status, 401);
+  }));
+});
diff --git a/e2e/organizations.spec.ts b/e2e/organizations.spec.ts
new file mode 100644
index 0000000..fab75a4
--- /dev/null
+++ b/e2e/organizations.spec.ts
@@ -0,0 +1,116 @@
+import { randomUUID } from "node:crypto";
+import { expect, test, type APIRequestContext } from "./fixtures";
+import { ADMIN_URL, API_URL } from "./environment";
+import { authenticatedApi, signIn } from "./helpers";
+import { withFixtureDatabase } from "./database";
+
+type Account = { id: string; email: string };
+type Fixture = {
+  prefix: string; organization: string; inactive: string; building: string;
+  name: string; inactiveName: string; buildingName: string;
+  pure: Account; flag: Account; outsider: Account;
+  capabilities: (account: Account, expected: string[]) => Promise<void>;
+  setCapability: (key: "organizations:read" | "organizations:manage", enabled: boolean) => Promise<void>;
+  revokeBinding: () => Promise<void>;
+};
+
+/** This suite owns the disposable cluster while changing the two platform grants.
+ * All UI requests use normal login/API/RLS; owner SQL only prepares/cleans fixtures. */
+async function withOrganizations(request: APIRequestContext, run: (fixture: Fixture) => Promise<void>) {
+  const prefix = `e2e-org-${randomUUID()}`;
+  const organization = `${prefix}-a`, inactive = `${prefix}-b`, building = `${prefix}-building`;
+  const account = (kind: string): Account => ({ id: `${prefix}-${kind}`, email: `${prefix}-${kind}@organizations.test` });
+  const pure = account("pure"), flag = account("flag"), outsider = account("outsider");
+  const users = [pure.id, flag.id, outsider.id], binding = randomUUID();
+  const name = `Cliente próprio ${prefix}`, inactiveName = `Cliente inativo ${prefix}`, buildingName = `Imóvel próprio ${prefix}`;
+  let grants: unknown[] | undefined;
+  try {
+    await withFixtureDatabase(async sql => {
+      grants = await sql`select * from role_permissions where role_key='PLATFORM_ADMIN'
+        and permission_key in ('organizations:read','organizations:manage') order by permission_key`;
+      expect(grants).toHaveLength(2);
+      await sql.begin(async tx => {
+        await tx`insert into organizations(id,name,slug,active,metadata) values
+          (${organization},${name},${organization},true,'{"preserve":"commercial metadata"}'),
+          (${inactive},${inactiveName},${inactive},false,'{}')`;
+        await tx`insert into buildings(id,organization_id,name,code) values(${building},${organization},${buildingName},${prefix.slice(-20)})`;
+        for (const current of [pure, flag, outsider]) {
+          const inserted = await tx`insert into users(id,email,name,password_hash,active,is_platform_admin)
+            select ${current.id},${current.email},${current.id},password_hash,true,${current.id === flag.id}
+            from users where email='admin@predioon.local' returning id`;
+          expect(inserted).toHaveLength(1);
+        }
+        await tx`insert into role_bindings(id,user_id,role_key) values(${binding},${pure.id},'PLATFORM_ADMIN')`;
+      });
+    });
+    const clients = new Map<string, Awaited<ReturnType<typeof authenticatedApi>>>();
+    await run({
+      prefix, organization, inactive, building, name, inactiveName, buildingName, pure, flag, outsider,
+      async capabilities(current, expected) {
+        let api = clients.get(current.id);
+        if (!api) { api = await authenticatedApi(request, current.email); clients.set(current.id, api); }
+        const response = await api.get("/v1/authorization/platform");
+        expect(response.status(), "A premissa usa a projeção real autenticada").toBe(200);
+        expect(response.headers()["cache-control"]).toBe("no-store");
+        expect(await response.json()).toEqual({ capabilities: [...expected].sort() });
+      },
+      async setCapability(key, enabled) {
+        await withFixtureDatabase(async sql => {
+          await sql`delete from role_permissions where role_key='PLATFORM_ADMIN' and permission_key=${key}`;
+          if (enabled) await sql`insert into role_permissions select * from jsonb_populate_recordset(null::role_permissions,${JSON.stringify(grants)}::jsonb) where permission_key=${key}`;
+        });
+      },
+      async revokeBinding() { await withFixtureDatabase(sql => sql`update role_bindings set active=false where id=${binding}`); },
+    });
+  } finally {
+    await withFixtureDatabase(async sql => sql.begin(async tx => {
+      if (grants) {
+        await tx`delete from role_permissions where role_key='PLATFORM_ADMIN' and permission_key in ('organizations:read','organizations:manage')`;
+        await tx`insert into role_permissions select * from jsonb_populate_recordset(null::role_permissions,${JSON.stringify(grants)}::jsonb)`;
+      }
+      await tx`delete from audit_logs where user_id in ${tx(users)} or resource_id in (${organization},${inactive},${building})`;
+      await tx`delete from buildings where id=${building}`;
+      // Only this scenario's unguessable slug namespace, including uncertain POST responses.
+      await tx`delete from organizations where slug like ${prefix + '%'} or id in (${organization},${inactive})`;
+      await tx`delete from users where id in ${tx(users)}`;
+    }));
+  }
+}
+
+test("organizações: RBAC puro entra em Clientes sem elevar o papel legado", async ({ page, request }) => withOrganizations(request, async f => {
+  await f.capabilities(f.pure, ["organizations:read", "organizations:manage"]);
+  const login = page.waitForResponse(response => response.url() === `${API_URL}/auth/web/login`);
+  await signIn(page, ADMIN_URL, f.pure.email);
+  expect((await (await login).json()).user.role).toBe("RESIDENT");
+  await expect(page).toHaveURL(`${ADMIN_URL}/clientes`);
+  await expect(page.getByRole("heading", { name: "Clientes", exact: true })).toBeVisible();
+  await expect(page.getByText(f.name, { exact: true })).toBeVisible();
+  await withFixtureDatabase(async sql => {
+    const [row] = await sql`select is_platform_admin from users where id=${f.pure.id}`;
+    expect(row!.is_platform_admin).toBe(false);
+  });
+}));
+
+test("organizações: leitor legado consulta ativos e inativos sem formulário ou ações", async ({ page, request }) => withOrganizations(request, async f => {
+  await f.setCapability("organizations:manage", false);
+  await f.capabilities(f.flag, ["organizations:read"]);
+  await signIn(page, ADMIN_URL, f.flag.email);
+  await page.goto(`${ADMIN_URL}/clientes`);
+  await expect(page.getByText(f.name, { exact: true })).toBeVisible();
+  await expect(page.getByText(f.inactiveName, { exact: true })).toBeVisible();
+  await expect(page.getByRole("button", { name: /Cadastrar|Editar|Desativar|Reativar/ })).toHaveCount(0);
+  await expect(page.getByLabel("Slug", { exact: true })).toHaveCount(0);
+}));
+
+test("organizações: Imóveis preserva sua lista sem consultar seletor comercial não autorizado", async ({ page, request }) => withOrganizations(request, async f => {
+  await f.setCapability("organizations:read", false);
+  await f.capabilities(f.flag, ["organizations:manage"]);
+  await signIn(page, ADMIN_URL, f.flag.email);
+  let organizationReads = 0;
+  page.on("request", current => { if (new URL(current.url()).pathname === "/organizations" && current.method() === "GET") organizationReads++; });
+  await page.goto(`${ADMIN_URL}/predios`);
+  await expect(page.getByText(f.buildingName, { exact: true })).toBeVisible();
+  expect(organizationReads, "Sem read comercial não há consulta de opções").toBe(0);
+  await expect(page.getByRole("button", { name: "Cadastrar", exact: true })).toBeDisabled();
+  await expect(page.getByText("Você não tem permissão para consultar clientes.", { exact: true })).toBeVisible();
+}));
