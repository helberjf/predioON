+  const users = [manager.id, other.id, delegate.id], role = `E2E_AUDIT_${f.suffix}`;
+  const local = `AUDIT_LOCAL_${f.suffix}`, foreign = `AUDIT_FOREIGN_${f.suffix}`, global = `audit-global-${f.suffix}`, unknown = `audit-unknown-${f.suffix}`;
