+  const history = await safeDatabaseOperation("owner ledger control", () => fixture.owner<{ id: string; checksum: string }[]>`
+    select id,checksum from public.schema_migrations order by id`);
+  assert.deepEqual([...history], fixture.canonicalHistory, "every applied canonical migration has its source checksum");
+  assert.ok(history.length === 51 || history.length === 52, "bounded fixture loads the actual 051 or 052 chain");
+  const syntheticId = randomUUID();
+  await safeDatabaseOperation("owner synthetic UUID isolation control", () => fixture.owner.begin(async transaction => {
+    await transaction`create table public.runtime_services_fixture_control(id uuid primary key)`;
+    await transaction`insert into public.runtime_services_fixture_control(id) values (${syntheticId})`;
+    const [row] = await transaction`select count(*)::int as total, bool_and(id=${syntheticId}::uuid) as only_fixture_id
+      from public.runtime_services_fixture_control`;
+    assert.ok(row?.total === 1 && row.only_fixture_id, "isolated state contains only the synthetic UUID created by this control");
+  }));
+}
+
+const serviceHelpers: Record<ServiceRole, readonly string[]> = {
+  predioon_ingest: [
+    "public.ingest_count_rejection(text,text)",
+    "public.ingest_lock_monitoring_profiles(text,text)",
+    "public.ingest_lock_parking_lot(text,text)",
+    "public.ingest_persist_alert(uuid,text,text,text,uuid,public.alert_severity,text,text,jsonb,timestamptz,timestamptz)",
+    "public.ingest_alert_outbox_signature(uuid,uuid)",
+    "public.ingest_write_parking_observation(uuid,text,text,text,integer,timestamptz,timestamptz,integer)",
+  ],
+  predioon_access_service: [
+    "public.access_service_next_pending()",
+    "public.access_service_expire_commands()",
+    "public.access_service_fail_pending(uuid,text)",
+    "public.access_service_mark_sent(uuid)",
+    "public.access_service_fail_publish(uuid,text)",
+    "public.access_service_apply_ack(uuid,text,text,text,text,text)",
+  ],
+};
+
+/** Feature assertions run in a test leaf, never in setup or restricted authentication. */
+export async function assertServiceCatalogue(fixture: RuntimeServicesFixture, role: ServiceRole): Promise<void> {
+  const [catalogue] = await safeDatabaseOperation("service role catalogue contract", () => fixture.owner`
+    select r.rolsuper, r.rolinherit, r.rolcreaterole, r.rolcreatedb, r.rolreplication, r.rolbypassrls,
+      exists(select 1 from pg_auth_members m where m.member=r.oid or m.roleid=r.oid) as has_memberships,
+      exists(select 1 from pg_shdepend d where d.refclassid='pg_authid'::regclass and d.refobjid=r.oid and d.deptype='o') as owns_objects,
+      has_database_privilege(r.oid,current_database(),'CONNECT') as can_connect,
+      has_database_privilege(r.oid,current_database(),'CREATE') as can_create_database_objects,
+      has_database_privilege(r.oid,current_database(),'TEMP') as can_create_temp,
+      has_schema_privilege(r.oid,'public','USAGE') as can_use_schema,
+      has_schema_privilege(r.oid,'public','CREATE') as can_create_schema_objects
+      from pg_roles r where r.rolname=${role}`);
+  assert.ok(catalogue, `052 feature contract: canonical migrations must create ${role}`);
+  assert.ok(!catalogue.rolsuper && !catalogue.rolinherit && !catalogue.rolcreaterole && !catalogue.rolcreatedb &&
+    !catalogue.rolreplication && !catalogue.rolbypassrls && !catalogue.has_memberships && !catalogue.owns_objects,
+  `${role} has restricted flags, zero ownership and no memberships in either direction`);
+  assert.ok(catalogue.can_connect && catalogue.can_use_schema && !catalogue.can_create_database_objects &&
+    !catalogue.can_create_temp && !catalogue.can_create_schema_objects, `${role} has only CONNECT/USAGE at database/schema scope`);
+
+  for (const signature of ["public.service_runtime_guard(name)", ...serviceHelpers[role]]) {
+    const [helper] = await safeDatabaseOperation("private helper catalogue contract", () => fixture.owner`
+      select p.oid::int, p.prosecdef, p.proconfig, p.prokind='f' as ordinary_function,
+        p.proowner=(select proowner from pg_proc where oid=to_regprocedure('public.app_has_capability(text,text,text,text)')) as fixed_owner,
+        exists(select 1 from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a
+          where a.grantee=0 and a.privilege_type='EXECUTE') as public_execute
+        from pg_proc p where p.oid=to_regprocedure(${signature})`);
+    assert.ok(helper, `052 feature contract: missing private helper ${signature}`);
+    assert.ok(helper.prosecdef && helper.ordinary_function && helper.fixed_owner && !helper.public_execute,
+      `${signature} is a private SECURITY DEFINER function owned by the fixed authorization owner`);
+    assert.ok(Array.isArray(helper.proconfig) && helper.proconfig.some((setting: string) =>
+      setting.replaceAll(/\s/g, "") === "search_path=pg_catalog,public,pg_temp"), `${signature} pins its search_path`);
+    for (const candidate of roleNames) {
+      const [permission] = await safeDatabaseOperation("helper execute isolation contract", () => fixture.owner`
+        select has_function_privilege(${candidate}, ${helper.oid}::oid, 'EXECUTE') as allowed`);
+      const allowed = signature !== "public.service_runtime_guard(name)" && candidate === role;
+      assert.equal(permission?.allowed, allowed, `${signature}: EXECUTE isolation for ${candidate}`);
+    }
+  }
+}
+
+/** One forbidden SQL operation per transaction; 25P02 never counts as permission denial. */
+export async function assertPermissionDenied(client: postgres.Sql, statement: string, forgedHumanContext = false): Promise<void> {
+  await assert.rejects(safeDatabaseOperation("bounded permission denial", () => client.begin(async transaction => {
+    if (forgedHumanContext) await transaction`select set_config('app.user_id','fixture-platform-admin',true),
+      set_config('app.role','PLATFORM_ADMIN',true)`;
+    await transaction.unsafe(statement);
+  })), codeIs("42501"));
+}
diff --git a/packages/db/test/ingest-runtime-extension-acl.test.ts b/packages/db/test/ingest-runtime-extension-acl.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ccec5fbbf579e770cce96c443f5b2323a0287c36
--- /dev/null
+++ b/packages/db/test/ingest-runtime-extension-acl.test.ts
@@ -0,0 +1,81 @@
+import assert from "node:assert/strict";
+import { after, before, describe, it } from "node:test";
+import { isDeepStrictEqual } from "node:util";
+import {
+  createRuntimeServicesFixture, parseRuntimeServicesEnvironment, runtimeServicesSkipReason,
+  safeDatabaseOperation, verifyOwnerPositiveControl, type RuntimeServicesFixture,
+} from "./fixtures/runtime-services.js";
+
+const configuration = parseRuntimeServicesEnvironment(process.env);
+
+// Catalogue metadata only. Never query Timescale job configuration or app data.
+// Inventory actual extension members and objects in its private schemas; PUBLIC
+// schema itself is shared, so unrelated public app relations are not swept in.
+async function inventory(fixture: RuntimeServicesFixture) {
+  const [row] = await safeDatabaseOperation("private Timescale ACL inventory", () => fixture.observer`
+    with extension as (select oid,extversion from pg_extension where extname='timescaledb'),
+    members as (select d.classid,d.objid from pg_depend d join extension e on e.oid=d.refobjid
+      where d.refclassid='pg_extension'::regclass and d.deptype='e'),
+    schemas as (select n.* from pg_namespace n where n.oid in
+      (select objid from members where classid='pg_namespace'::regclass)),
+    relations as (select c.* from pg_class c where c.oid in
+      (select objid from members where classid='pg_class'::regclass)
+      or c.relnamespace in (select oid from schemas where nspname<>'public')),
+    functions as (select p.* from pg_proc p where p.oid in
+      (select objid from members where classid='pg_proc'::regclass)
+      or p.pronamespace in (select oid from schemas where nspname<>'public')),
+    acls as (
+      select 'schema'::text as kind,n.oid as object,0 as column_number,a.* from schemas n
+      cross join lateral aclexplode(coalesce(n.nspacl,acldefault('n',n.nspowner))) a
+      union all select 'relation',c.oid,0,a.* from relations c
+      cross join lateral aclexplode(coalesce(c.relacl,acldefault(case when c.relkind='S' then 'S'::"char" else 'r'::"char" end,c.relowner))) a
+      union all select 'column',c.oid,t.attnum,a.* from relations c join pg_attribute t on t.attrelid=c.oid
+      cross join lateral aclexplode(t.attacl) a where t.attnum>0 and not t.attisdropped
+      union all select 'function',p.oid,0,a.* from functions p
+      cross join lateral aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a)
+    select jsonb_build_object(
+      'version',(select extversion from extension),
+      'schemas',coalesce((select jsonb_agg(jsonb_build_object('oid',oid,'name',nspname,'owner',nspowner,'acl',nspacl) order by oid) from schemas),'[]'::jsonb),
+      'relations',coalesce((select jsonb_agg(jsonb_build_object('oid',oid,'schema',relnamespace,'name',relname,'owner',relowner,'acl',relacl) order by oid) from relations),'[]'::jsonb),
+      'columns',coalesce((select jsonb_agg(jsonb_build_object('relation',t.attrelid,'column',t.attnum,'acl',t.attacl) order by t.attrelid,t.attnum)
+        from pg_attribute t join relations c on c.oid=t.attrelid where t.attnum>0 and not t.attisdropped),'[]'::jsonb),
+      'functions',coalesce((select jsonb_agg(jsonb_build_object('oid',oid,'owner',proowner,'acl',proacl) order by oid) from functions),'[]'::jsonb),
+      'public',coalesce((select jsonb_agg(to_jsonb(a) order by kind,object,column_number,grantor,privilege_type,is_grantable) from acls a where grantee=0),'[]'::jsonb)
+    ) as snapshot,
+    exists(select 1 from acls a join pg_roles r on r.oid=a.grantee
+      where r.rolname in ('predioon_ingest','predioon_access_service')) as own_service_grant`);
+  assert.ok(row?.snapshot && typeof row.snapshot === "object", "extension catalogue inventory returned metadata");
+  return { snapshot: row.snapshot as { version: string; schemas: unknown[]; relations: unknown[]; functions: unknown[]; public: unknown[] }, ownServiceGrant: row.own_service_grant };
+}
+
+describe("052 preserves actual Timescale extension ACLs", {
+  concurrency: false, skip: configuration ? false : runtimeServicesSkipReason,
+}, () => {
+  let fixture: RuntimeServicesFixture | undefined;
+  let baseline: Awaited<ReturnType<typeof inventory>> | undefined;
+  before(async () => { fixture = await createRuntimeServicesFixture(configuration!, { baselineRelease: 51 }); });
+  after(async () => { await fixture?.cleanup(); });
+
+  it("owner and independent observer inventory real extension ACLs on 051 before checking candidate presence", async () => {
+    await verifyOwnerPositiveControl(fixture!);
+    const [owner] = await safeDatabaseOperation("extension owner connection control", () => fixture!.owner`select pg_backend_pid() as pid`);
+    const [observer] = await safeDatabaseOperation("extension independent observer control", () => fixture!.observer`select pg_backend_pid() as pid`);
+    assert.ok(owner?.pid && observer?.pid && owner.pid !== observer.pid, "owner and observer use independent backends");
+    baseline = await inventory(fixture!);
+    assert.ok(typeof baseline.snapshot.version === "string" && baseline.snapshot.schemas.length > 0 &&
+      baseline.snapshot.relations.length > 0 && baseline.snapshot.functions.length > 0 && baseline.snapshot.public.length > 0,
+    "actual Timescale version, object ownership, ACLs and PUBLIC inventory are populated; no universal count assumption");
+    assert.equal(baseline.ownServiceGrant, false, "canonical 051 extension objects have no direct service-role grant");
+  });
+
+  it("052 preserves extension owners and PUBLIC ACL inventory without adding an own grant for either service", async context => {
+    if (!baseline) { context.skip("requires successful real 051 extension owner control"); return; }
+    assert.ok(fixture!.candidate052, "052 candidate is required after the successful 051 extension control");
+    assert.deepEqual(await fixture!.applyCandidate052(), [fixture!.candidate052!.id]);
+    const current = await inventory(fixture!);
+    assert.ok(isDeepStrictEqual(current.snapshot, baseline.snapshot), "all observed extension owners/ACLs and PUBLIC privileges remain identical");
+    assert.equal(current.ownServiceGrant, false, "neither service receives a direct extension object grant");
+    assert.deepEqual(await fixture!.applyCandidate052(), [], "runner replay remains a ledger no-op");
+    assert.ok(isDeepStrictEqual((await inventory(fixture!)).snapshot, current.snapshot), "replay preserves the actual extension inventory");
+  });
+});
diff --git a/packages/db/test/ingest-runtime-hardening-regression.test.ts b/packages/db/test/ingest-runtime-hardening-regression.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2a953984ce772e08c198f841ebdcd12067db22a5
--- /dev/null
+++ b/packages/db/test/ingest-runtime-hardening-regression.test.ts
@@ -0,0 +1,85 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { isDeepStrictEqual } from "node:util";
+import {
+  codeIs, createRuntimeServicesFixture, parseRuntimeServicesEnvironment, runtimeServicesSkipReason,
+  safeDatabaseOperation, verifyOwnerPositiveControl, type RuntimeServicesFixture,
+} from "./fixtures/runtime-services.js";
+import { boundedTransaction, seedRuntimeServiceData } from "./fixtures/runtime-service-data.js";
+
+const configuration = parseRuntimeServicesEnvironment(process.env);
+const matcher = "public.app_automation_matches(public.automation_versions,text,public.alert_severity,text)";
+
+async function baselineCase(run: (fixture: RuntimeServicesFixture) => Promise<void>) {
+  const fixture = await createRuntimeServicesFixture(configuration!, { baselineRelease: 51 });
+  try {
+    await verifyOwnerPositiveControl(fixture);
+    assert.ok(fixture.candidate052, "canonical 052 is required after the successful 051 owner control");
+    await run(fixture);
+  } finally { await fixture.cleanup(); }
+}
+
+async function matcherSnapshot(fixture: RuntimeServicesFixture) {
+  const [row] = await safeDatabaseOperation("private canonical matcher metadata", () => boundedTransaction(fixture.observer, tx => tx`
+    select to_jsonb(p) as definition from pg_proc p where p.oid=to_regprocedure(${matcher})`));
+  assert.ok(row?.definition, "the real canonical matcher exists");
+  return row.definition;
+}
+
+describe("052 exact pure matcher exception and heartbeat association", {
+  concurrency: false, skip: configuration ? false : runtimeServicesSkipReason,
+}, () => {
+  it("accepts the unchanged canonical matcher and rejects a foreign gateway while inactive/disabled-gateway heartbeat remains operational", async () => {
+    await baselineCase(async fixture => {
+      const data = await seedRuntimeServiceData(fixture);
+      const before = await matcherSnapshot(fixture);
+      assert.deepEqual(await fixture.applyCandidate052(), [fixture.candidate052!.id]);
+      assert.ok(isDeepStrictEqual(await matcherSnapshot(fixture), before), "052 preserves the complete original matcher catalogue row and ACL");
+      await fixture.provisionRuntime();
+      await safeDatabaseOperation("inactive source with disabled but associated gateway", () => boundedTransaction(fixture.owner, async tx => {
+        await tx`update public.buildings set active=false where id=${data.building}`;
+        await tx`update public.gateways set enabled=false where id=${data.gateway}`;
+      }));
+      const positive = await safeDatabaseOperation("associated enabled source still records its heartbeat", () => boundedTransaction(fixture.ingest, tx => tx`
+        update public.devices set status='OFFLINE',last_seen_at=clock_timestamp(),updated_at=clock_timestamp()
+        where id=${data.meter} returning id`));
+      assert.equal(positive.length, 1);
+      await safeDatabaseOperation("owner establishes cross-building association negative control", () => boundedTransaction(fixture.owner, tx => tx`
+        update public.devices set gateway_id=${data.otherGateway} where id=${data.meter}`));
+      const [invalid] = await safeDatabaseOperation("independent observer confirms foreign gateway control", () => boundedTransaction(fixture.observer, tx => tx`
+        select d.gateway_id,g.building_id<>d.building_id as foreign_parent from public.devices d
+        join public.gateways g on g.id=d.gateway_id where d.id=${data.meter}`));
+      assert.ok(invalid?.foreign_parent && invalid.gateway_id === data.otherGateway);
+      await assert.rejects(safeDatabaseOperation("foreign gateway heartbeat rejected by WITH CHECK", () => boundedTransaction(fixture.ingest, tx => tx`
+        update public.devices set status='ONLINE',last_seen_at=clock_timestamp() where id=${data.meter}`)), codeIs("42501"));
+      const [unchanged] = await safeDatabaseOperation("denied heartbeat leaves operational state unchanged", () => boundedTransaction(fixture.observer, tx => tx`
+        select status from public.devices where id=${data.meter}`));
+      assert.equal(unchanged?.status, "OFFLINE");
+      await safeDatabaseOperation("owner establishes optional-gateway positive control", () => boundedTransaction(fixture.owner, tx => tx`
+        update public.devices set gateway_id=null where id=${data.meter}`));
+      const standalone = await safeDatabaseOperation("source without gateway still records heartbeat", () => boundedTransaction(fixture.ingest, tx => tx`
+        update public.devices set status='ONLINE',last_seen_at=clock_timestamp() where id=${data.meter} returning id`));
+      assert.equal(standalone.length, 1);
+    });
+  });
+
+  for (const [label, mutation] of [
+    ["rewritten body", `CREATE OR REPLACE FUNCTION ${matcher.replace("(public.automation_versions,text,public.alert_severity,text)", "(target public.automation_versions, alert_type text, alert_level public.alert_severity, alert_device text)")}
+      RETURNS boolean LANGUAGE sql IMMUTABLE AS 'SELECT true'`],
+    ["SECURITY DEFINER", `ALTER FUNCTION ${matcher} SECURITY DEFINER`],
+    ["non-immutable definition", `ALTER FUNCTION ${matcher} STABLE`],
+    ["changed effective ACL", `GRANT EXECUTE ON FUNCTION ${matcher} TO predioon_app`],
+  ] as const) {
+    it(`does not extend the matcher exception to a ${label}`, async () => {
+      await baselineCase(async fixture => {
+        await safeDatabaseOperation("controlled fixture-only matcher alteration", () => boundedTransaction(fixture.owner, tx => tx.unsafe(mutation)));
+        const before = await matcherSnapshot(fixture);
+        await assert.rejects(fixture.applyCandidate052(), codeIs("42501"));
+        assert.ok(isDeepStrictEqual(await matcherSnapshot(fixture), before), "failed migration preserves the altered matcher rather than repairing it");
+        const [ledger] = await safeDatabaseOperation("failed matcher guard leaves ledger at 051", () => boundedTransaction(fixture.observer, tx => tx`
+          select count(*)::int as count from public.schema_migrations`));
+        assert.equal(ledger?.count, 51);
+      });
+    });
+  }
+});
diff --git a/packages/db/test/ingest-runtime-migration.test.ts b/packages/db/test/ingest-runtime-migration.test.ts
