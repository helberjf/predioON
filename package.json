{
  "name": "predio-on-platform",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:reset": "docker compose -f infrastructure/docker-compose.yml down -v",
    "db:wait": "pnpm --filter @predioon/db db:wait",
    "db:bootstrap": "pnpm --filter @predioon/db db:bootstrap",
    "db:push": "pnpm --filter @predioon/db db:push",
    "db:infra": "pnpm --filter @predioon/db db:infra",
    "db:provision-runtime": "pnpm --filter @predioon/db db:provision-runtime",
    "db:seed": "pnpm --filter @predioon/db db:seed",
    "setup:local": "pnpm infra:up && pnpm db:wait && pnpm db:bootstrap && pnpm db:infra && pnpm db:provision-runtime && pnpm db:seed",
    "dev": "pnpm -r --parallel dev",
    "simulate:hardware": "pnpm --filter @predioon/ingest simulator",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "pnpm -r --workspace-concurrency=1 --filter @predioon/api-client --filter @predioon/ui --filter @predioon/mobile --filter @predioon/api --filter @predioon/ingest test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "postgres": "3.4.9"
  }
}
