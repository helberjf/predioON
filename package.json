{
  "name": "predio-on-platform",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:reset": "docker compose -f infrastructure/docker-compose.yml down -v",
    "db:wait": "pnpm --filter @predioon/db db:wait",
    "db:bootstrap": "pnpm --filter @predioon/db db:bootstrap",
    "db:push": "pnpm --filter @predioon/db db:push",
    "db:infra": "pnpm --filter @predioon/db db:infra",
    "db:provision-runtime": "pnpm --filter @predioon/db db:provision-runtime",
    "db:telemetry-retention": "pnpm --filter @predioon/db db:telemetry-retention",
    "db:seed": "pnpm --filter @predioon/db db:seed",
    "setup:local": "pnpm infra:up && pnpm db:wait && pnpm db:bootstrap && pnpm db:infra && pnpm db:provision-runtime && pnpm ingest:env && pnpm db:seed",
    "ingest:env": "node scripts/write-ingest-runtime-env.mjs",
    "dev": "pnpm -r --parallel dev",
    "simulate:hardware": "pnpm --filter @predioon/ingest simulator",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "pnpm -r --workspace-concurrency=1 --filter @predioon/api-client --filter @predioon/ui --filter @predioon/mobile --filter @predioon/api --filter @predioon/ingest test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:report": "playwright show-report .local/playwright-report",
    "typecheck:e2e": "pnpm --filter @predioon/mobile exec tsc -p ../../e2e/tsconfig.json",
    "check:e2e-selectors": "node scripts/check-e2e-selectors.mjs",
    "e2e:db": "node scripts/e2e-db.mjs",
    "e2e:record": "node scripts/e2e-record.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "postgres": "3.4.9"
  }
}
