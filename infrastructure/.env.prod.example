# Prédio ON — variáveis de produção. Copie para infrastructure/.env.prod e preencha.
# Esse arquivo NÃO vai para o git.

# ---- Domínio ----
# Aponte cinco registros A para o IP da VPS:
#   api.SEUDOMINIO  admin.SEUDOMINIO  sindico.SEUDOMINIO  morador.SEUDOMINIO  mqtt.SEUDOMINIO
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# ---- Banco ----
# Gere senhas distintas em base64url: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
BROKER_AUTH_DB_PASSWORD=

# ---- API ----
# Par Ed25519; PEM pode conter a sequência literal \n. Não use o par efêmero de desenvolvimento.
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY=
# Objeto JSON: {"kid":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
JWT_PUBLIC_KEYS=
# Segredo exclusivo do limitador; gere pelo menos 32 bytes aleatórios em base64url.
# Todas as réplicas usam o mesmo valor. Não reutilize senhas nem chaves JWT/MQTT.
AUTH_RATE_LIMIT_KEY=
# Rede exclusiva Caddy/API. O Compose confia somente neste endereço /32 do Caddy.
# Se houver colisão com a rede da VPS/VPN, altere o par, mantendo o IP dentro do CIDR.
PROXY_NETWORK_CIDR=172.30.250.0/29
PROXY_IPV4_ADDRESS=172.30.250.2

# ---- MQTT ----
# EMQX valida as credenciais na API interna; não é preciso duplicar cadastros.
MQTT_INGEST_USERNAME=predioon_ingest
MQTT_INGEST_PASSWORD=
EMQX_DASHBOARD_PASSWORD=
# Gere em base64url, com pelo menos 32 caracteres, compartilhado só entre API e EMQX.
MQTT_AUTH_SECRET=
# Diretório absoluto com fullchain.pem e privkey.pem para mqtt.SEUDOMINIO.
# Certificado emitido por CA confiável, com leitura permitida ao UID do EMQX.
MQTT_CERTS_DIR=

# ---- Opcionais ----
# Recebe um POST em cada alerta HIGH/CRITICAL: ligue num serviço de WhatsApp ou e-mail.
ALERT_WEBHOOK_URL=
# Senha dos usuários de demonstração, se rodar o setup com --seed.
SEED_PASSWORD=
