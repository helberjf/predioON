# Prédio ON — variáveis de produção. Copie para infrastructure/.env.prod e preencha.
# Esse arquivo NÃO vai para o git.

# ---- Domínio ----
# Aponte quatro registros A para o IP da VPS:
#   api.SEUDOMINIO  admin.SEUDOMINIO  sindico.SEUDOMINIO  morador.SEUDOMINIO
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# ---- Banco ----
# Gere cada uma com: openssl rand -base64 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ---- API ----
# 32 caracteres no mínimo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- MQTT ----
# Credencial que o serviço de ingestão usa no broker. Cadastre a mesma no EMQX.
MQTT_INGEST_USERNAME=predioon_ingest
MQTT_INGEST_PASSWORD=
EMQX_DASHBOARD_PASSWORD=

# ---- Opcionais ----
# Recebe um POST em cada alerta HIGH/CRITICAL: ligue num serviço de WhatsApp ou e-mail.
ALERT_WEBHOOK_URL=
# Senha dos usuários de demonstração, se rodar o setup com --seed.
SEED_PASSWORD=
