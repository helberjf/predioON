# Prédio ON — variáveis de produção. Copie para infrastructure/.env.prod e preencha.
# Esse arquivo NÃO vai para o git.

# ---- Domínio ----
# Aponte cinco registros A para o IP da VPS:
#   api.SEUDOMINIO  admin.SEUDOMINIO  sindico.SEUDOMINIO  morador.SEUDOMINIO  mqtt.SEUDOMINIO
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# ---- Banco ----
# Gere sete senhas distintas em base64url (mínimo 32 caracteres):
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
BROKER_AUTH_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
# Serviço de ingestão: observação (telemetria) e acesso físico têm logins separados (SQL052).
INGEST_DB_PASSWORD=
ACCESS_SERVICE_DB_PASSWORD=

# ---- API ----
# Par Ed25519; PEM pode conter a sequência literal \n. Não use o par efêmero de desenvolvimento.
JWT_ACTIVE_KID=
JWT_PRIVATE_KEY=''
# Objeto JSON: {"kid":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
JWT_PUBLIC_KEYS=''
# Segredo exclusivo do limitador; gere pelo menos 32 bytes aleatórios em base64url.
# Todas as réplicas usam o mesmo valor. Não reutilize senhas nem chaves JWT/MQTT.
AUTH_RATE_LIMIT_KEY=
# Chave que cifra os segredos da verificação em duas etapas (32 bytes aleatórios ou mais).
# Opcional, mas NUNCA a troque depois de haver contas com a verificação ativa: os fatores deixam de validar.
MFA_ENCRYPTION_KEY=
# Chave do QR que o totem do portão mostra e troca a cada hora (32 bytes aleatórios ou mais).
# Opcional: sem ela a abertura por QR fica indisponível. Trocá-la só invalida os QR da hora; os tablets mostram o novo em até 1 minuto.
GATE_QR_SECRET=
# E-mail pelo Resend: recuperação de senha e convites. Opcional; sem a chave nada é enviado.
# O remetente precisa ser de um domínio verificado na sua conta do Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Portal aberto pelo link de recuperação pedido fora dos portais (apps), por exemplo https://morador.seudominio.com.br
PASSWORD_RESET_URL=
# Portal do morador; com ele e a chave acima, o convite também segue por e-mail.
RESIDENT_PORTAL_URL=
# Rede exclusiva Caddy/API. O Compose confia somente neste endereço /32 do Caddy.
# Se houver colisão com a rede da VPS/VPN, altere os três valores, mantendo ambos os IPs no CIDR.
PROXY_NETWORK_CIDR=172.30.250.0/29
PROXY_IPV4_ADDRESS=172.30.250.2
API_PROXY_IPV4_ADDRESS=172.30.250.3

# ---- MQTT ----
# EMQX valida as credenciais na API interna; não é preciso duplicar cadastros.
MQTT_INGEST_USERNAME=predioon_ingest
MQTT_INGEST_PASSWORD=
EMQX_DASHBOARD_PASSWORD=
# Gere em base64url, com pelo menos 32 caracteres, compartilhado só entre API e EMQX.
MQTT_AUTH_SECRET=
# Diretório absoluto com fullchain.pem e privkey.pem para mqtt.SEUDOMINIO.
# Certificado emitido por CA confiável, com leitura permitida ao UID do EMQX.
# Diretórios precisam permitir travessia (x); os arquivos precisam permitir leitura (r).
MQTT_CERTS_DIR=
# Portas padrão da VPS. Para testes isolados, escolha outras portas e use 127.0.0.1.
WEB_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
MQTT_BIND_ADDRESS=0.0.0.0
MQTT_TLS_PORT=8883

# ---- Opcionais ----
# Worker restrito: HTTPS recebe alertas HIGH/CRITICAL com chave de idempotência.
# Sem destino, novos eventos ficam terminais no_destination; não há backfill automático.
ALERT_WEBHOOK_URL=
# Senha explícita dos usuários de demonstração, se rodar --seed (mínimo 16 caracteres).
SEED_PASSWORD=
