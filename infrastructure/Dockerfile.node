# Imagem comum da API, ingestão e worker restrito de notificações.
# Escolha o serviço com --build-arg SERVICE=api|ingest|notifications.
FROM node:24-slim AS base

ARG SERVICE=api
ENV SERVICE=${SERVICE}
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable

WORKDIR /app

# Os manifestos vêm primeiro para aproveitar o cache de camadas do Docker:
# mudar código-fonte não reinstala dependências.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/contracts/package.json packages/contracts/
COPY packages/api-client/package.json packages/api-client/
COPY packages/db/package.json packages/db/
COPY packages/ui/package.json packages/ui/
COPY apps/api/package.json apps/api/
COPY services/ingest/package.json services/ingest/
COPY services/notifications/package.json services/notifications/

RUN pnpm install --frozen-lockfile --filter @predioon/api --filter @predioon/ingest --filter @predioon/notifications --filter @predioon/db --filter @predioon/shared

COPY packages ./packages
COPY apps/api ./apps/api
COPY services/ingest ./services/ingest
COPY services/notifications ./services/notifications
COPY infrastructure/*.sql ./infrastructure/

# tsx executa o TypeScript direto: sem etapa de build, sem risco de o artefato
# publicado divergir do código. O custo é alguns segundos a mais no start.
# Node recebe sinais como PID1; não há pnpm intermediário consumindo SIGTERM.
CMD ["sh", "-c", "case \"$SERVICE\" in api) cd /app/apps/api && exec node --import tsx src/server.ts ;; ingest|notifications) cd \"/app/services/$SERVICE\" && exec node --import tsx src/index.ts ;; *) echo 'SERVICE inválido' >&2; exit 64 ;; esac"]
