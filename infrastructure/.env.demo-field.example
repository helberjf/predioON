# Campo de demonstração (docker-compose.demo-field.yml). Copie para .env.demo-field.
# As duas URLs usam os logins restritos do banco de demonstração, habilitados com
#   pnpm --filter @predioon/db db:provision-runtime --field-only
# Use o host direto do Neon (sem "-pooler") e sslmode=verify-full.
DATABASE_URL_INGEST=
DATABASE_URL_ACCESS_SERVICE=
# Condomínios que o gateway simulado vai "tocar", separados por vírgula.
DEMO_FIELD_BUILDINGS=
# Intervalo entre ciclos do gateway simulado, em milissegundos (5000 a 30000).
DEMO_FIELD_INTERVAL_MS=15000
# Painel do EMQX, sem porta pública (acesso só por túnel SSH).
EMQX_DASHBOARD_PASSWORD=
