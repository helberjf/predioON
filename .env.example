# ---- Banco ----
# Conexão DONA: migrations, seed e o serviço de ingestão.
DATABASE_URL=postgres://predioon:predioon@localhost:5434/predioon
# Conexão da API: role NÃO-DONA, para o RLS do PostgreSQL valer de verdade.
DATABASE_URL_APP=postgres://predioon_app:predioon_app@localhost:5434/predioon

# ---- API ----
API_PORT=3000
JWT_SECRET=troque-por-um-segredo-de-no-minimo-32-caracteres
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://predio-on-admin.vercel.app,https://predio-on-sindico.vercel.app,https://predio-on-morador.vercel.app

# ---- MQTT ----
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=predioon_ingest
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=predioon-ingest-local
GATEWAY_OFFLINE_TIMEOUT_SECONDS=120
DEVICE_OFFLINE_TIMEOUT_SECONDS=300

# ---- Painéis ----
VITE_API_URL=http://localhost:3000
