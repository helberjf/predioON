# ---- Banco ----
# Conexão DONA: migrations, seed e o serviço de ingestão.
DATABASE_URL=postgres://predioon:predioon@localhost:5434/predioon
# Conexão da API: role NÃO-DONA, para o RLS do PostgreSQL valer de verdade.
DATABASE_URL_APP=postgres://predioon_app:predioon_app@localhost:5434/predioon
# Identidade e autenticação do broker têm privilégios próprios; nunca usam a conexão dona.
DATABASE_URL_IDENTITY=postgres://predioon_identity:predioon_identity@localhost:5434/predioon
DATABASE_URL_BROKER_AUTH=postgres://predioon_broker_auth:predioon_broker_auth@localhost:5434/predioon

# ---- API ----
API_PORT=3000
# Produção: gere um par Ed25519 e configure as três variáveis abaixo.
# JWT_ACTIVE_KID=2026-09
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEYS='{"2026-09":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'
# Em desenvolvimento, a API gera um par efêmero quando as três não são configuradas.
JWT_ACCESS_TTL_MINUTES=5
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://predio-on-admin.vercel.app,https://predio-on-sindico.vercel.app,https://predio-on-morador.vercel.app

# ---- MQTT ----
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=predioon_ingest
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=predioon-ingest-local
# Para broker com autenticador HTTP. Em desenvolvimento isolado são opcionais.
# MQTT_AUTH_SECRET=<segredo interno de pelo menos 32 caracteres>
# MQTT_INGEST_USERNAME=predioon_ingest
# MQTT_INGEST_PASSWORD=<mesma senha configurada em MQTT_PASSWORD>
# MQTT_CA_FILE=<CA privada, apenas se não usar certificado público confiável>
GATEWAY_OFFLINE_TIMEOUT_SECONDS=120
DEVICE_OFFLINE_TIMEOUT_SECONDS=300

# ---- Painéis ----
VITE_API_URL=http://localhost:3000
