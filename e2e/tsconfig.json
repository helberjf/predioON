{
  // Playwright transpiles without checking types; `pnpm typecheck:e2e` does the checking.
  // Node types come from packages/mobile so the root keeps no extra dependency.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "typeRoots": ["../packages/mobile/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts", "../playwright.record.config.ts"]
}
