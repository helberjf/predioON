# Ambiente do serviço de ingestão. Gere services/ingest/.env.runtime com `pnpm ingest:env`
# a partir do .env administrativo; não copie DATABASE_URL nem credenciais de outros serviços:
# a ingestão recusa iniciar com qualquer chave fora desta lista.
DATABASE_URL_INGEST=postgres://predioon_ingest:predioon_ingest@localhost:5434/predioon
DATABASE_URL_ACCESS_SERVICE=postgres://predioon_access_service:predioon_access_service@localhost:5434/predioon
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=predioon_ingest
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=predioon-ingest-local
GATEWAY_OFFLINE_TIMEOUT_SECONDS=120
DEVICE_OFFLINE_TIMEOUT_SECONDS=300
